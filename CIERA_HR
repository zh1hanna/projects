"""
Hertzsprung-Russell (HR) diagram

Plots stellar temperature vs. luminosity for a small star dataset.
Point color shows temperature (hot = blue, cool = red) and point size
shows stellar radius, estimated from the Stefan-Boltzmann relation.

Data and exercise: CIERA REACH program (Northwestern University),
https://github.com/CIERA-Northwestern/REACHpy
"""

import os
import urllib.request

import matplotlib.pyplot as plt
import numpy as np

DATA_URL = (
    "https://raw.githubusercontent.com/CIERA-Northwestern/"
    "REACHpy/main/Module_2/data/HRstars.csv"
)
DATA_PATH = os.path.join("data", "HRstars.csv")

T_SUN = 5780        # Sun's surface temperature (K)
SIZE_SCALE = 15     # multiplier so marker sizes are visible on the plot


def load_data(path=DATA_PATH, url=DATA_URL):
    """Download the CSV if needed, then return (temperature, luminosity) arrays."""
    if not os.path.exists(path):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        urllib.request.urlretrieve(url, path)

    data = np.genfromtxt(
        path, delimiter=",", skip_header=1, filling_values=np.nan, encoding="utf-8"
    )
    return data[:, 0], data[:, 1]  # temperature (K), luminosity (solar units)


def estimate_radius(luminosity, temperature):
    """Radius in solar radii, from L/Lsun = (R/Rsun)^2 * (T/Tsun)^4."""
    return np.sqrt(luminosity / (temperature / T_SUN) ** 4)


def plot_hr_diagram(temperature, luminosity, save_as="hr_diagram.png"):
    """Draw the HR diagram: log-log axes, temperature decreasing to the right."""
    radius = estimate_radius(luminosity, temperature)

    fig, ax = plt.subplots(figsize=(8, 6))
    points = ax.scatter(
        temperature,
        luminosity,
        c=np.log10(temperature),          # log scale: temperatures span orders of magnitude
        cmap=plt.get_cmap("RdYlBu"),      # red = cool, blue = hot
        s=SIZE_SCALE * radius,
        alpha=0.75,
    )

    ax.set_xscale("log")
    ax.set_yscale("log")
    ax.set_xlim(100000, 900)              # reversed: HR diagrams run hot -> cool
    ax.set_ylim(1e-4, 1e8)

    ax.set_title("HR Diagram")
    ax.set_xlabel("Temperature (K)")
    ax.set_ylabel("Luminosity (solar luminosities)")

    fig.colorbar(points, ax=ax, label="log10(Temperature)")
    fig.tight_layout()
    fig.savefig(save_as, dpi=150)
    plt.show()


if __name__ == "__main__":
    temp, lum = load_data()
    plot_hr_diagram(temp, lum)
